  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6e6a86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6e6a86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#eb6f92",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#eb6f92"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ea9a97",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9ccfd8"
      }
    },
    {
      "name": "Object & Class Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Interfaces & Type Aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#ea9a97"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#e0def4"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "Language Builtin Variables (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#eb6f92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#31748f"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#908caa"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#eb6f92"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#c4a7e7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#e0def4"
      }
    },
    {
      "name": "PHP Namespaces & Use Statements",
      "scope": [
        "support.other.namespace.use.php",
        "support.other.namespace.php",
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Laravel Blade Directives",
      "scope": [
        "keyword.blade",
        "entity.name.function.blade",
        "punctuation.definition.directive.blade"
      ],
      "settings": {
        "foreground": "#eb6f92",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luau Builtins & Globals",
      "scope": [
        "support.function.lua",
        "support.function.luau",
        "support.constant.lua",
        "support.variable.lua"
      ],
      "settings": {
        "foreground": "#9ccfd8"
      }
    },
    {
      "name": "Luau Type Annotations",
      "scope": [
        "entity.name.type.lua",
        "entity.name.type.luau",
        "meta.type.annotation.lua"
      ],
      "settings": {
        "foreground": "#ea9a97"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "CSS Selectors (Classes & IDs)",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "JSON Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#eb6f92"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#eb6f92",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code & Inline Raw",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "name": "Markdown Links & URLs",
      "scope": [
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9ccfd8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#6e6a86",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#ebbcba",
    "variable.readonly": "#ea9a97",
    "property.readonly": "#ea9a97",
    "type": "#ea9a97",
    "class": "#f6c177",
    "interface": "#f6c177",
    "enum": "#f6c177",
    "enumMember": "#ea9a97",
    "function": "#9ccfd8",
    "method": "#c4a7e7",
    "macro": "#eb6f92",
    "keyword": "#eb6f92",
    "modifier": "#f6c177",
    "comment": "#6e6a86",
    "string": "#ebbcba",
    "number": "#f6c177",
    "regexp": "#eb6f92",
    "operator": "#31748f",
    "namespace": "#f6c177",
    "selfKeyword": {
      "foreground": "#eb6f92",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "fontStyle": "bold"
    }
  }
}