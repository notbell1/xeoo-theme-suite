  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#657461",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#657461",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#be123c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#9f1239"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#be123c"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a16207",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Object & Class Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "Interfaces & Type Aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#1a2418"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#364532"
      }
    },
    {
      "name": "Language Builtin Variables (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#be123c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#657461"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#166534",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#1a2418"
      }
    },
    {
      "name": "PHP Namespaces & Use Statements",
      "scope": [
        "support.other.namespace.use.php",
        "support.other.namespace.php",
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "Laravel Blade Directives",
      "scope": [
        "keyword.blade",
        "entity.name.function.blade",
        "punctuation.definition.directive.blade"
      ],
      "settings": {
        "foreground": "#be123c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luau Builtins & Globals",
      "scope": [
        "support.function.lua",
        "support.function.luau",
        "support.constant.lua",
        "support.variable.lua"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Luau Type Annotations",
      "scope": [
        "entity.name.type.lua",
        "entity.name.type.luau",
        "meta.type.annotation.lua"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#364532"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "CSS Selectors (Classes & IDs)",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "JSON Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#be123c"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#be123c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code & Inline Raw",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Markdown Links & URLs",
      "scope": [
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#15803d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c2410c"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#166534"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#657461",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#7e22ce",
    "variable.readonly": "#a16207",
    "property.readonly": "#a16207",
    "type": "#15803d",
    "class": "#166534",
    "interface": "#166534",
    "enum": "#166534",
    "enumMember": "#a16207",
    "function": "#15803d",
    "method": "#166534",
    "macro": "#be123c",
    "keyword": "#be123c",
    "modifier": "#9f1239",
    "comment": "#657461",
    "string": "#b45309",
    "number": "#c2410c",
    "regexp": "#be123c",
    "operator": "#15803d",
    "namespace": "#166534",
    "selfKeyword": {
      "foreground": "#be123c",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "fontStyle": "bold"
    }
  }
}