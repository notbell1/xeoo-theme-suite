  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#587364",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#587364",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#fca5a5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#fef08a"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f59e0b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Object & Class Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#86efac"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#86efac"
      }
    },
    {
      "name": "Interfaces & Type Aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#f0fdf4"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#6ee7b7"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#bbf7d0"
      }
    },
    {
      "name": "Language Builtin Variables (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f87171",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#22c55e"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#7ea08d"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#22c55e"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#4ade80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#f0fdf4"
      }
    },
    {
      "name": "PHP Namespaces & Use Statements",
      "scope": [
        "support.other.namespace.use.php",
        "support.other.namespace.php",
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#86efac"
      }
    },
    {
      "name": "Laravel Blade Directives",
      "scope": [
        "keyword.blade",
        "entity.name.function.blade",
        "punctuation.definition.directive.blade"
      ],
      "settings": {
        "foreground": "#f87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luau Builtins & Globals",
      "scope": [
        "support.function.lua",
        "support.function.luau",
        "support.constant.lua",
        "support.variable.lua"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Luau Type Annotations",
      "scope": [
        "entity.name.type.lua",
        "entity.name.type.luau",
        "meta.type.annotation.lua"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#bbf7d0"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "CSS Selectors (Classes & IDs)",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "JSON Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#f87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code & Inline Raw",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#fef08a"
      }
    },
    {
      "name": "Markdown Links & URLs",
      "scope": [
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4ade80",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#587364",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#6ee7b7",
    "variable.readonly": "#f59e0b",
    "property.readonly": "#f59e0b",
    "type": "#4ade80",
    "class": "#86efac",
    "interface": "#86efac",
    "enum": "#86efac",
    "enumMember": "#f59e0b",
    "function": "#4ade80",
    "method": "#86efac",
    "macro": "#f87171",
    "keyword": "#f87171",
    "modifier": "#fca5a5",
    "comment": "#587364",
    "string": "#fef08a",
    "number": "#fb923c",
    "regexp": "#f472b6",
    "operator": "#22c55e",
    "namespace": "#86efac",
    "selfKeyword": {
      "foreground": "#f87171",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "fontStyle": "bold"
    }
  }
}