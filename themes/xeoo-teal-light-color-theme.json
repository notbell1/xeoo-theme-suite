  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#134e4a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#b45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1d4ed8"
      }
    },
    {
      "name": "Object & Class Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Interfaces & Type Aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#6b21a8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#1e293b"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#9333ea"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#334155"
      }
    },
    {
      "name": "Language Builtin Variables (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#64748b"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#7e22ce",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#1e293b"
      }
    },
    {
      "name": "PHP Namespaces & Use Statements",
      "scope": [
        "support.other.namespace.use.php",
        "support.other.namespace.php",
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Laravel Blade Directives",
      "scope": [
        "keyword.blade",
        "entity.name.function.blade",
        "punctuation.definition.directive.blade"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luau Builtins & Globals",
      "scope": [
        "support.function.lua",
        "support.function.luau",
        "support.constant.lua",
        "support.variable.lua"
      ],
      "settings": {
        "foreground": "#1d4ed8"
      }
    },
    {
      "name": "Luau Type Annotations",
      "scope": [
        "entity.name.type.lua",
        "entity.name.type.luau",
        "meta.type.annotation.lua"
      ],
      "settings": {
        "foreground": "#6b21a8"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#334155"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "CSS Selectors (Classes & IDs)",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "JSON Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code & Inline Raw",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Markdown Links & URLs",
      "scope": [
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#1d4ed8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c2410c"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7e22ce"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#9333ea",
    "variable.readonly": "#b45309",
    "property.readonly": "#b45309",
    "type": "#6b21a8",
    "class": "#7e22ce",
    "interface": "#7e22ce",
    "enum": "#7e22ce",
    "enumMember": "#b45309",
    "function": "#1d4ed8",
    "method": "#0369a1",
    "macro": "#0f766e",
    "keyword": "#0f766e",
    "modifier": "#134e4a",
    "comment": "#64748b",
    "string": "#15803d",
    "number": "#c2410c",
    "regexp": "#0f766e",
    "operator": "#0f766e",
    "namespace": "#7e22ce",
    "selfKeyword": {
      "foreground": "#0f766e",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "fontStyle": "bold"
    }
  }
}