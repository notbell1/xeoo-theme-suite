  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6272a4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6272a4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#ff92d0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ff5555"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d1b3ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Object & Class Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#80ff9e"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#a4eeff"
      }
    },
    {
      "name": "Interfaces & Type Aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "Language Builtin Variables (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8d9ec9"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#50fa7b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "PHP Namespaces & Use Statements",
      "scope": [
        "support.other.namespace.use.php",
        "support.other.namespace.php",
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#a4eeff"
      }
    },
    {
      "name": "Laravel Blade Directives",
      "scope": [
        "keyword.blade",
        "entity.name.function.blade",
        "punctuation.definition.directive.blade"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luau Builtins & Globals",
      "scope": [
        "support.function.lua",
        "support.function.luau",
        "support.constant.lua",
        "support.variable.lua"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Luau Type Annotations",
      "scope": [
        "entity.name.type.lua",
        "entity.name.type.luau",
        "meta.type.annotation.lua"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "CSS Selectors (Classes & IDs)",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "JSON Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code & Inline Raw",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "Markdown Links & URLs",
      "scope": [
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#50fa7b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#6272a4",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#ffb86c",
    "variable.readonly": "#d1b3ff",
    "property.readonly": "#d1b3ff",
    "type": "#8be9fd",
    "class": "#a4eeff",
    "interface": "#a4eeff",
    "enum": "#a4eeff",
    "enumMember": "#d1b3ff",
    "function": "#50fa7b",
    "method": "#80ff9e",
    "macro": "#ff79c6",
    "keyword": "#ff79c6",
    "modifier": "#ff92d0",
    "comment": "#6272a4",
    "string": "#f1fa8c",
    "number": "#bd93f9",
    "regexp": "#ff5555",
    "operator": "#ff79c6",
    "namespace": "#a4eeff",
    "selfKeyword": {
      "foreground": "#ff79c6",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "fontStyle": "bold"
    }
  }
}