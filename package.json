{
  "name": "xeoo-theme",
  "displayName": "Xeoo Theme",
  "description": "A master suite of 26 professionally calibrated Dark & Light themes with an interactive sidebar switcher. Designed for zero eye-strain and WCAG-compliant contrast.",
  "version": "1.0.0",
  "publisher": "ZXMARCHIA",
  "icon": "assets/xeoo-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "paper",
    "crimson",
    "ruby",
    "cyberpunk",
    "contrast",
    "php",
    "laravel",
    "javascript",
    "typescript",
    "luau"
  ],
  "scripts": {
    "build": "node src/build.js",
    "watch": "node src/build.js --watch",
    "package": "node src/package.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xeoo-theme-sidebar",
          "title": "Xeoo Theme",
          "icon": "assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "xeoo-theme-sidebar": [
        {
          "id": "xeoo-theme-switcher",
          "name": "Theme Switcher"
        }
      ]
    },
    "commands": [
      {
        "command": "xeoo-theme.applyTheme",
        "title": "Apply Theme",
        "category": "Xeoo Theme"
      },
      {
        "command": "xeoo-theme.quickPick",
        "title": "Quick Pick Theme Palette",
        "category": "Xeoo Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "xeoo-theme.randomTheme",
        "title": "Surprise Me! (Random Theme)",
        "category": "Xeoo Theme",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xeoo-theme.quickPick",
          "when": "view == xeoo-theme-switcher",
          "group": "navigation"
        },
        {
          "command": "xeoo-theme.randomTheme",
          "when": "view == xeoo-theme-switcher",
          "group": "navigation"
        }
      ]
    },
    "themes": [
      {
        "label": "Xeoo Crimson Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/xeoo-crimson-dark-color-theme.json"
      },
      {
        "label": "Xeoo Midnight Ruby",
        "uiTheme": "vs-dark",
        "path": "./themes/xeoo-midnight-ruby-color-theme.json"
      },
