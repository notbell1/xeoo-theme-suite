{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Inline HTML in JS/TS Template Strings",
  "scopeName": "inline.html.injection",
  "injectionSelector": "L:source.js -comment -string, L:source.jsx -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [
    {
      "name": "meta.embedded.block.html",
      "contentName": "text.html.basic",
      "begin": "((?:\\s*?(?:\\w+\\.)?(?:html|/\\*\\s*html\\s*\\*/)\\s*)|(?=`[\\s\\r\\n]*(?:<!--|<(?:!DOCTYPE|!doctype|[a-zA-Z][a-zA-Z0-9:-]*)[\\s>/])))(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "string.template.js punctuation.definition.string.template.begin.js"
        }
      },
      "end": "(`)",
      "endCaptures": {
        "1": {
          "name": "string.template.js punctuation.definition.string.template.end.js"
        }
      },
      "patterns": [
        {
          "include": "#template-substitution-element"
        },
        {
          "include": "text.html.basic"
        }
      ]
    }
  ],
  "repository": {
    "template-substitution-element": {
      "name": "meta.template.expression.js",
      "begin": "((?<!\\\\)\\${)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.js"
        }
      },
      "end": "(})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.js"
        }
      },
      "patterns": [
        {
          "include": "source.js#expression"
        },
        {
          "include": "source.ts#expression"
        },
        {
          "include": "source.js"
        }
      ]
    }
  }
}
